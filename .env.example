# Without DATABASE_URL, one local server uses persistent embedded PostgreSQL.
DATABASE_URL=
LOCAL_DATABASE_PATH=.data/kiez
# Demo auto-seeds once. Set an anchor explicitly to rehearse on a particular date.
DEMO_DATA=true
DEMO_ANCHOR_DATE=
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.6-flash
GEMINI_TRANSCRIPTION_MODEL=gemini-3.6-flash
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_VOICE=Kore
# Enable languages after testing them with your project's models.
ENABLED_AUDIO_LANGUAGES=en,de,tr,ar,es
# Set independent random secrets before deployment (openssl rand -hex 32).
SESSION_SECRET=
CRON_SECRET=
ADMIN_SECRET=
NEXT_PUBLIC_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# OpenAI: Chronicle extraction, writing and review (server-side only).
OPENAI_API_KEY=
OPENAI_CHRONICLE_MODEL=gpt-4.1
